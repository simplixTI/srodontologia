# =============================================================
# SR Digital · Example environment file
# Copy to .env.local for local dev; never commit real values.
# =============================================================

# ─── Supabase (REQUIRED) ─────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ─── App (REQUIRED for absolute URLs in emails/webhooks) ─────
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEPLOY_ENV=local

# ─── Cron secret (REQUIRED in prod) ──────────────────────────
CRON_SECRET=

# ─── Stripe (billing) ────────────────────────────────────────
# Without STRIPE_SECRET_KEY, checkout runs in mock mode.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: pre-configured price ids (fallback if not stored in plans table).
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_STARTER_YEARLY=price_...
STRIPE_PRICE_PROFESSIONAL_MONTHLY=price_...
STRIPE_PRICE_PROFESSIONAL_YEARLY=price_...
STRIPE_PRICE_BUSINESS_MONTHLY=price_...
STRIPE_PRICE_BUSINESS_YEARLY=price_...

# ─── Email (transactional) ───────────────────────────────────
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=no-reply@srdigital.com.br

# ─── AI providers (optional) ─────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
OPENROUTER_API_KEY=

# ─── Rate limiting (distributed, optional) ───────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Error tracking (optional) ───────────────────────────────
SENTRY_DSN=

# ─── TOTP secret encryption key (REQUIRED in prod) ───────────
TOTP_SECRET_KEY=change-me-to-a-32-plus-char-random-string
