# =============================================================
# SR HUB — environment variables
# Copy to .env.local and fill in the real values.
# NEVER commit .env.local to git.
# =============================================================

# ─── Public site ────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.srodontologiadigital.com.br

# ─── Supabase ───────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://wcxwngfuwwzylcmsgoyu.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# SERVER-ONLY. Never expose to the browser. Never commit.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Initial admin bootstrap (Aline) ────────────────────────
# Used ONLY by scripts/create-admin.mjs. After the first run
# you can delete these variables from the environment.
INITIAL_ADMIN_EMAIL=alinebabo@yahoo.com.br
INITIAL_ADMIN_PASSWORD=change-me-strong-temporary-password
INITIAL_ADMIN_NAME=Aline

# ─── Resend (transactional emails) ─────────────────────────
# Server-only. Domain srodontologiadigital.com.br is verified in Resend.
RESEND_API_KEY=re_your_key_here
# Optional — defaults to "SR Digital <no-reply@srodontologiadigital.com.br>"
# RESEND_FROM="SR HUB <hub@srodontologiadigital.com.br>"
